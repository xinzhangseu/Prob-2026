#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)

changed_files=$(git diff --cached --name-only --diff-filter=ACMR)

if ! printf '%s\n' "$changed_files" | grep -Eq '^Lectures/(L[0-9][0-9]\.tex|Prob-All\.tex|beamerthemenankai\.sty|figures/)'; then
  exit 0
fi

echo "检测到课件源文件变更，提交前自动更新 Lectures/Prob-All.pdf。"
"$repo_root/scripts/build-prob-all.sh"
git add "$repo_root/Lectures/Prob-All.pdf"
echo "已将最新的 Lectures/Prob-All.pdf 加入本次提交。"
